            "default": "https://api.openai.com/v1",
            "required": true,
            "order": 10
          },
          {
            "key": "api_key",
            "binding": "api_key",
            "type": "secret",
            "label": "API 密钥",
            "description": "作为 Bearer token 转发给上游。",
            "required": true,
            "order": 20
          },
          {
            "key": "price_multiplier",
            "binding": "price_multiplier",
            "type": "number",
            "label": "价格倍率",
            "default": 1,
            "required": true,
            "order": 30
          }
        ]
      }
    }
  ]
}
